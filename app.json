{
  "expo": {
    "name": "moskito",
    "slug": "moskito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Aedex.png",
    "scheme": "moskito",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Aedex.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.xelpaxu.moskito"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Aedex.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "@rnmapbox/maps",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Aedex.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AEDEX to access your photos to detect mosquito breeding sites.",
          "savePhotosPermission": true,
          "isAccessMediaLocationEnabled": true,
          "isAudioLibraryEnabled": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e66f8a4-a53a-4c79-baf6-b7f66d832adf"
      }
    }
  }
}
