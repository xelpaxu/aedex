{
  "expo": {
    "name": "moskito",
    "slug": "moskito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Aedex.png",
    "scheme": "moskito",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_MEDIA_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Aedex.png",
        "backgroundImage": "./assets/images/Aedex.png",
        "monochromeImage": "./assets/images/Aedex.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.xelpaxu.moskito",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "moskito",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Aedex.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Aedex.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AEDEX to access your photos to detect mosquito breeding sites.",
          "savePhotosPermission": "Allow AEDEX to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AEDEX to access your location to map mosquito breeding sites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AEDEX to access your photos.",
          "cameraPermission": "Allow AEDEX to use the camera."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "scheme": "moskito",
        "origin": "http://localhost:8081"
      },
      "eas": {
        "projectId": "3e66f8a4-a53a-4c79-baf6-b7f66d832adf"
      }
    }
  }
}
